 "hypotheses": [
  {
   "claim": "Trace access raises accuracy by >= 0.10 (self-protective agents)",
   "design_note": "Measured, but partly by design: claims-only investigators cannot verify anything.",
   "id": "H1",
   "numbers": {
    "acc_claims_only": 0.09666666666666666,
    "acc_full": 0.6466666666666666,
    "diff": 0.5499999999999999,
    "p": 9.1438991302582e-100
   },
   "supported": true
  },
  {
   "claim": "Trace access at least halves false blame",
   "design_note": "Measured; magnitude depends on the designer-chosen investigator rule.",
   "id": "H2",
   "numbers": {
    "false_blame_claims_only": 0.83,
    "false_blame_full": 0.3433333333333333
   },
   "supported": true
  },
  {
   "claim": "Blame incentive matters only without trace access",
   "design_note": "Refuted by a design choice: uncited claims cannot be refuted and still win the fallback vote.",
   "id": "H3",
   "numbers": {
    "fb_diff_claims_only": 0.83,
    "fb_diff_full": 0.3433333333333333
   },
   "supported": false
  },
  {
   "claim": "Rounds to answer: flat <= hub <= chain",
   "design_note": "Refuted; chain's mean is selection-biased (averaged over successful runs only).",
   "id": "H4",
   "numbers": {
    "mean_steps": {
     "chain": 1.5,
     "flat": 1.4838709677419355,
     "hub": 2.0709677419354837
    }
   },
   "supported": false
  },
  {
   "claim": "Chain relaying costs >= 0.10 accuracy vs flat",
   "design_note": "Measured; driven by designed citation drops (p=0.15) and relay rewrites.",
   "id": "H5",
   "numbers": {
    "acc_chain": 0.39,
    "acc_flat": 0.775,
    "diff": 0.385,
    "p": 1.3234889800848443e-23
   },
   "supported": true
  },
  {
   "claim": "A hub mediator gains >= 0.05 accuracy vs flat",
   "design_note": "Refuted; the mediator's one check duplicates the investigator's first check (design).",
   "id": "H6",
   "numbers": {
    "acc_flat": 0.775,
    "acc_hub": 0.775,
    "diff": 0.0,
    "p": 1.0
   },
   "supported": false
  }
